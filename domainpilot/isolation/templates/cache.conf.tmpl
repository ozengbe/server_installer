# Managed by DomainPilot for tenant ${tenant}. Regenerated by `site`; do not edit.
# Unix socket only, readable only by the tenant's own user.
port 0
unixsocket ${cache_socket}
unixsocketperm 700
daemonize no
supervised systemd
loglevel notice
logfile ""
databases 16
dir ${cache_data}
save ""
appendonly no
maxmemory ${cache_maxmemory}mb
maxmemory-policy allkeys-lru
protected-mode yes
enable-debug-command no
enable-module-command no
enable-protected-configs no
# Tenants manage their own keys but not the server.
user default on nopass ~* &* +@all -@admin -config -debug -module -monitor -shutdown -acl -replicaof -slaveof -sync -psync -failover -cluster -migrate -restore
