# Managed by Ozenix: resource limits for tenant ${tenant} (all its services).
[Unit]
Description=Ozenix tenant ${tenant}
Before=slices.target

[Slice]
CPUQuota=${cpu_quota}%
MemoryAccounting=yes
MemoryHigh=${memory_high}M
MemoryMax=${memory_max}M
MemorySwapMax=${swap_max}M
TasksAccounting=yes
TasksMax=${tasks_max}
IOAccounting=yes
IOWeight=100
