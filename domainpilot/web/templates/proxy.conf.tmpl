# Managed by DomainPilot for ${domain} (tenant ${tenant}). Regenerated by `site`; do not edit.
# Reverse proxy to a public HTTPS upstream (verified certificate).
server {
    listen 80;
    listen [::]:80;
    server_name ${server_names};

    access_log ${log_dir}/access.log dp_json;
    error_log ${log_dir}/error.log warn;

    limit_req zone=dp_req burst=40 nodelay;
    include /etc/nginx/domainpilot/snippets/security-headers.conf;

    location / {
        proxy_pass ${upstream};
        proxy_http_version 1.1;
        proxy_set_header Host ${upstream_host};
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
        proxy_set_header X-Forwarded-Host $$host;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_name ${upstream_host};
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }
}
