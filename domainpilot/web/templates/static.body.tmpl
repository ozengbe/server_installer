    root ${docroot};
    index index.html;

    disable_symlinks if_not_owner from=$$document_root;
    limit_req zone=dp_req burst=40 nodelay;

    include /etc/nginx/domainpilot/snippets/security-headers.conf;
${hsts}
    include /etc/nginx/domainpilot/snippets/deny-sensitive.conf;

    location / {
        try_files $$uri $$uri/ =404;
    }

    # No PHP runtime for static sites: never hand .php files out as source.
    location ~* \.php$$ {
        return 404;
    }

    location ~* \.(?:css|js|mjs|png|jpe?g|gif|webp|avif|svg|ico|woff2?)$$ {
        expires 7d;
        add_header Cache-Control "public" always;
        # add_header in a location replaces the server-level ones: repeat them.
        include /etc/nginx/domainpilot/snippets/security-headers.conf;
${hsts}
    }
