    root ${docroot};
    index index.php index.html;

    # Files are served only if the symlink and its target have the same owner.
    disable_symlinks if_not_owner from=$$document_root;
    limit_req zone=dp_req burst=40 nodelay;

    include /etc/nginx/domainpilot/snippets/security-headers.conf;
${hsts}
    include /etc/nginx/domainpilot/snippets/deny-sensitive.conf;

    location / {
        try_files $$uri $$uri/ /index.php?$$args;
    }

    location ~ \.php$$ {
        try_files $$uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$$;
        include /etc/nginx/fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $$document_root$$fastcgi_script_name;
        fastcgi_param HTTPS $$https if_not_empty;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:${php_socket};
        fastcgi_read_timeout 120s;
        fastcgi_intercept_errors on;
    }
