# Managed by DomainPilot for ${domain} (tenant ${tenant}). Regenerated by `site`; do not edit.
# Port 80 only answers ACME challenges and redirects to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${server_names};

    access_log ${log_dir}/access.log dp_json;
    error_log ${log_dir}/error.log warn;

    include /etc/nginx/domainpilot/snippets/acme.conf;

    location / {
        return 301 https://$$host$$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${server_names};

    ssl_certificate ${certificate};
    ssl_certificate_key ${certificate_key};

    access_log ${log_dir}/access.log dp_json;
    error_log ${log_dir}/error.log warn;

${body}
}
