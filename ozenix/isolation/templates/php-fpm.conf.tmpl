; Managed by ozenix for tenant ${tenant}. Regenerated by `site`; do not edit.
; This master runs as ${tenant} inside the dp-php@${tenant} sandbox (no root, no pool switching).
[global]
pid = ${run_dir}/php/php-fpm.pid
error_log = ${log_dir}/php-fpm.log
log_level = notice
daemonize = no
systemd_interval = 10
emergency_restart_threshold = 5
emergency_restart_interval = 1m
process_control_timeout = 10s

[${tenant}]
listen = ${php_socket}
listen.owner = ${tenant}
listen.group = ${tenant}
listen.mode = 0660
pm = ondemand
pm.max_children = ${max_children}
pm.process_idle_timeout = 30s
pm.max_requests = 500
request_terminate_timeout = 120s
chdir = ${root}/app
clear_env = yes
catch_workers_output = yes
security.limit_extensions = .php
; Defence in depth only: the sandbox (mount namespace, AppArmor) is the boundary.
${open_basedir_line}
php_admin_value[memory_limit] = ${php_memory_limit}M
php_admin_value[upload_tmp_dir] = ${root}/tmp
php_admin_value[session.save_path] = ${root}/tmp
php_admin_value[sys_temp_dir] = ${root}/tmp
php_admin_value[error_log] = ${log_dir}/php-error.log
php_admin_flag[log_errors] = on
php_admin_flag[display_errors] = off
; MemoryDenyWriteExecute=yes in the unit forbids JIT code pages.
php_admin_flag[pcre.jit] = off
php_admin_value[disable_functions] = ${disable_functions}
${laravel_lines}
