    limit_req zone=dp_req burst=40 nodelay;
    include /etc/nginx/ozenix/snippets/security-headers.conf;
${hsts}

    # The site's own Node.js/Python app (dp-app@${tenant}), on loopback only.
    location / {
        proxy_pass http://127.0.0.1:${app_port};
        proxy_http_version 1.1;
        proxy_set_header Host $$host;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
        proxy_set_header X-Forwarded-Host $$host;
        # WebSockets (Socket.IO, Next.js dev, ...)
        proxy_set_header Upgrade $$http_upgrade;
        proxy_set_header Connection $$dp_connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
    }
