# Managed by ozenix. Laravel queue worker of one site (`php artisan queue:work`),
# switched on with `site <domain> laravel queue on`.
[Unit]
Description=ozenix Laravel queue worker for tenant %i
After=network.target mariadb.service dp-cache@%i.service
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=dp-alert@%n.service
ConditionPathExists=/etc/ozenix/tenants/%i/laravel.env
ConditionPathExists=/srv/tenants/%i/app/artisan

[Service]
Type=simple
Restart=always
RestartSec=5
User=%i
Group=%i
Slice=dptenants-%i.slice
EnvironmentFile=/etc/ozenix/tenants/%i/laravel.env
WorkingDirectory=/srv/tenants/%i/app
ExecStart=/bin/sh -c 'exec "$$PHP_BIN" -d variables_order=EGPCS -d pcre.jit=0 artisan queue:work --sleep=3 --tries=3 --max-time=3600 --no-interaction'

UMask=0027
StandardOutput=append:/var/log/ozenix/tenants/%i/laravel-queue.log
StandardError=append:/var/log/ozenix/tenants/%i/laravel-queue.log
# Same sandbox as the site's PHP, with the "-exec" AppArmor profile (queued jobs may start
# `php artisan ...` child processes).
TemporaryFileSystem=/srv/tenants:ro /etc/ozenix:ro /var/log/ozenix:ro /run/ozenix:ro /var/lib/ozenix:ro
BindReadOnlyPaths=/srv/tenants/%i /srv/tenants/%i/app /etc/ozenix/tenants/%i
BindPaths=/srv/tenants/%i/data /srv/tenants/%i/tmp /var/log/ozenix/tenants/%i
BindReadOnlyPaths=-/run/ozenix/%i/cache
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
KeyringMode=private
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
SocketBindDeny=any
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @swap @reboot @raw-io @module @clock @cpu-emulation @debug @obsolete
SystemCallErrorNumber=EPERM
IPAddressDeny=169.254.0.0/16 fe80::/10 fd00:ec2::254/128

# The site's AppArmor profile for programs: same files as PHP, and it may start
# only PHP, sh, Python, Node.js and the site's own code.
AppArmorProfile=ozenix-tenant-%i-exec

[Install]
WantedBy=multi-user.target
