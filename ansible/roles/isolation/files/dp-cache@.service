# Managed by DomainPilot. Sandbox for one tenant's cache server (Valkey/Redis),
# unix socket only. Per-tenant settings: dp-cache@<tenant>.service.d/10-tenant.conf
[Unit]
Description=DomainPilot cache for tenant %i
After=network.target
ConditionPathExists=/etc/domainpilot/tenants/%i/cache.conf
StartLimitIntervalSec=300
StartLimitBurst=5
# After the last failed restart: alert (role monitoring, dp-alert@.service).
OnFailure=dp-alert@%n.service

[Service]
Type=notify
User=%i
Group=%i
ExecStart=/bin/false
Restart=on-failure
RestartSec=5
UMask=0077

RuntimeDirectory=domainpilot/%i/cache
RuntimeDirectoryMode=0750
# Kept on stop: the other unit of this tenant may have it bind-mounted.
RuntimeDirectoryPreserve=yes

TemporaryFileSystem=/srv/tenants:ro /etc/domainpilot:ro /var/log/domainpilot:ro /run/domainpilot:ro /var/lib/domainpilot:ro
BindReadOnlyPaths=/etc/domainpilot/tenants/%i
BindPaths=/var/lib/domainpilot/cache/%i /run/domainpilot/%i/cache
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
KeyringMode=private
RemoveIPC=yes

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @swap @reboot @raw-io @module @clock @cpu-emulation @debug @obsolete
SystemCallErrorNumber=EPERM

AppArmorProfile=domainpilot-tenant-%i

[Install]
WantedBy=multi-user.target
