#!/bin/sh
# Managed by ozenix: welcome screen shown at SSH login (run by pam_motd as root).
# Keep it fast and read-only: it runs on every login. Banner lines are printed
# with '%s' so backslashes are never interpreted.

version=$(sed -n 's/^ *"version": "\([0-9a-z.]*\)".*/\1/p' /var/lib/ozenix/release.json 2>/dev/null)
sites=$(find /srv/tenants -mindepth 1 -maxdepth 1 -type d -name 't[0-9][0-9][0-9][0-9]' 2>/dev/null | wc -l)

printf '%s\n' \
  '' \
  '   ___                  _' \
  '  / _ \ _______ _ __  (_)_  __' \
  " | | | |_  / _ \\ '_ \\ | \\ \\/ /" \
  ' | |_| |/ /  __/ | | || |>  <' \
  '  \___//___\___|_| |_||_/_/\_\' \
  ''
printf '  Secure web hosting server%s  |  sites: %s\n\n' "${version:+  |  ozenix $version}" "$sites"
printf '%s\n' \
  '  sudo site example.com create --user john --key john.pub' \
  '                                    new website with its own user (SSH/SFTP, HTTPS)' \
  "  sudo site example.com ssl         Let's Encrypt certificate now" \
  '  sudo site example.com sftp create --key laptop.pub --name laptop   (another key)' \
  '  sudo site example.com db create   database for the site' \
  '  sudo site list                    all sites' \
  '  sudo site system status           server status and health' \
  '  site help                         all common commands' \
  '' \
  '  Documentation: {{ dp_motd_docs_url }}'
{% if dp_motd_coffee_url %}
printf '%s\n' '  ozenix is free. If it helps you, buy me a coffee: {{ dp_motd_coffee_url }}'
{% endif %}
printf '\n'
