# Site users (`site <domain> create --user NAME --key FILE`): SSH keys only,
# a shell and SFTP in their own site, no tunnels or forwarding of any kind.
# Their home is the site root /srv/tenants/<tid> (root-owned), so they cannot
# create ~/.ssh: keys come only from /etc/ssh/authorized_keys.d/<user>.
Match Group dp-sftp
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    AuthenticationMethods publickey
    PermitListen none
    PermitOpen none
    AllowTcpForwarding no
    AllowStreamLocalForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTunnel no
