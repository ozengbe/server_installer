Match Group dp-admins
    AllowTcpForwarding {{ dp_admin_tcp_forwarding }}

# Tenant SFTP accounts (populated from Phase 8). Chroot must be root-owned;
# until Phase 8 creates it, logins for this group fail closed.
Match Group dp-sftp
    ForceCommand internal-sftp -l INFO
    ChrootDirectory /srv/sftp/%u
    PermitTTY no
    AllowTcpForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTunnel no