Match Group dp-admins
    AllowTcpForwarding {{ dp_admin_tcp_forwarding }}

# Tenant SFTP (deploy users, `site <d> sftp create`). The chroot is the tenant
# root /srv/tenants/<tid> (the deploy user's home): root-owned, 0750, so the
# user sees only app/ and data/ of its own site. umask 027: the web server and
# PHP read uploads through the tenant group; nobody else can.
Match Group dp-sftp
    ForceCommand internal-sftp -l INFO -d /app -u 0027
    ChrootDirectory %h
    PermitListen none
    PermitOpen none
    PermitTTY no
    AllowTcpForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTunnel no