#!/usr/sbin/nft -f
# Managed by DomainPilot (role firewall). Applied via dp-firewall (auto-rollback).
# Only this table is managed; other tables (e.g. fail2ban) are left alone.

# Atomic replace of our table (create-if-missing, delete, redefine).
table inet domainpilot
delete table inet domainpilot

table inet domainpilot {
{% if dp_ssh_allow_v4 %}
	set ssh_allow_v4 {
		type ipv4_addr
		flags interval
		elements = { {{ dp_ssh_allow_v4 | join(', ') }} }
	}
{% endif %}
{% if dp_ssh_allow_v6 %}
	set ssh_allow_v6 {
		type ipv6_addr
		flags interval
		elements = { {{ dp_ssh_allow_v6 | join(', ') }} }
	}
{% endif %}

	chain input {
		type filter hook input priority filter; policy drop;

		ct state invalid drop
		ct state established,related accept
		iif "lo" accept

		meta l4proto icmp icmp type echo-request limit rate 20/second burst 50 packets accept
		meta l4proto icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		# IPv6 does not work without neighbour discovery and router advertisements.
		meta l4proto ipv6-icmp icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert, packet-too-big, destination-unreachable, time-exceeded, parameter-problem, mld-listener-query } accept
		meta l4proto ipv6-icmp icmpv6 type echo-request limit rate 20/second burst 50 packets accept
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept comment "DHCPv6 client"

		# Administrative SSH (tenant SFTP shares this port; sshd enforces groups)
{% if not dp_ssh_allow_v4 and not dp_ssh_allow_v6 %}
		tcp dport 22 accept
{% else %}
{% if dp_ssh_allow_v4 %}
		ip saddr @ssh_allow_v4 tcp dport 22 accept
{% endif %}
{% if dp_ssh_allow_v6 %}
		ip6 saddr @ssh_allow_v6 tcp dport 22 accept
{% endif %}
{% endif %}

{% if dp_firewall_public_tcp %}
		tcp dport { {{ dp_firewall_public_tcp | join(', ') }} } accept comment "public tcp"
{% endif %}
{% if dp_firewall_public_udp %}
		udp dport { {{ dp_firewall_public_udp | join(', ') }} } accept comment "public udp"
{% endif %}
{% if dp_wireguard_port | int > 0 %}
		udp dport {{ dp_wireguard_port | int }} accept comment "wireguard"
{% endif %}

		limit rate 10/minute burst 20 packets log prefix "dp-fw-in-drop " level info
		counter comment "dropped by policy"
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}

	chain output {
		type filter hook output priority filter; policy accept;
		# Phase 4: per-tenant egress policy is inserted here (jump tenant_egress).
	}
}
