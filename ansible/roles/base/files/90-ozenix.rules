## Managed by ozenix: changes to privileged configuration and root commands run by humans.
-w /etc/ozenix/ -p wa -k ozenix-config
-w /etc/ssh/sshd_config -p wa -k sshd
-w /etc/ssh/sshd_config.d/ -p wa -k sshd
-w /etc/ssh/authorized_keys.d/ -p wa -k ssh-keys
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers
-w /etc/nftables.conf -p wa -k firewall
-w /usr/sbin/nft -p x -k firewall
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-a always,exit -F arch=b64 -S execve -F euid=0 -F auid>=1000 -F auid!=unset -k admin-exec
-a always,exit -F arch=b32 -S execve -F euid=0 -F auid>=1000 -F auid!=unset -k admin-exec
